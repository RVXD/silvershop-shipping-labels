{
    "name": "silvershop/shipping-labels",
    "description": "Carrier-connected shipping label generation for SilverShop: a pluggable provider layer (Manual, MyParcel, …) with single-label creation and printing from the CMS.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "shipping", "label", "fulfilment", "carrier"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-shipping-labels/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/siteconfig": "^6.0",
        "silvershop/core": "^6",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "suggest": {
        "silvershop/store-profile": "Central shop identity + sender address, shared with invoicing and other modules."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\ShippingLabels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\ShippingLabels\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
